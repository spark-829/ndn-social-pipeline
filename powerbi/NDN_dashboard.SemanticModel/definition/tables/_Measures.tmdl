		lineageTag: 9db883ef-1dbb-56d2-a72a-f7d5c5c4eb2f

	measure 'Artists scored' = COUNTROWS ( invite )
		formatString: #,0
		displayFolder: 2 Invite
		lineageTag: 59d27c05-2de2-5e70-9559-a9df1a823d56

	measure 'Recommended now' = CALCULATE ( COUNTROWS ( invite ), KEEPFILTERS ( invite[status] = "Recommend" ) )
		formatString: #,0
		displayFolder: 2 Invite
		lineageTag: 84a21b53-53ad-5ee7-8d8c-4eb1c2128f84

	/// Good artists whose current hit is already on NDN's YouTube, or who have no new hit since their last visit.
	measure 'Not now' = CALCULATE ( COUNTROWS ( invite ), KEEPFILTERS ( invite[status] = "Not now" ) )
		formatString: #,0
		displayFolder: 2 Invite
		lineageTag: 1022d124-af62-5abb-91fe-b8a3742e2adf

	/// Played for NDN in the last 10 months, so not recommended again yet.
	measure 'Cooling down now' = CALCULATE ( COUNTROWS ( invite ), KEEPFILTERS ( invite[status] = "Cooling down" ) )
		formatString: #,0
		displayFolder: 2 Invite
		lineageTag: 33a452a7-090d-5afd-8607-96b17a2df50c

	column placeholder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8f490794-1439-5cdc-a840-aee0487c1f63
		summarizeBy: none
		sourceColumn: placeholder

		annotation SummarizationSetBy = User

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [placeholder = Int64.Type], {{1}})
				in
				    Source
