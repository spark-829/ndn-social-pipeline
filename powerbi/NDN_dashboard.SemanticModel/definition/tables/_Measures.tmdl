/// Holds every DAX measure; the placeholder column is hidden.
table _Measures
	lineageTag: a7610168-a129-5d42-9da4-679b27f1bd07

	/// TikTok followers at the latest daily public count, 9 am PH.
	measure 'TikTok Followers Text' = FORMAT ( CALCULATE ( SUM ( scorecard[followers] ), KEEPFILTERS ( dim_platform[platform] = "TikTok" ) ), "#,0" )
		displayFolder: 1 Overview
		lineageTag: 5758e63b-aaf5-57fb-988b-e2c04f90e682

	/// Follower change over about the last week. YouTube rounds subscribers, so small changes can show as none.
	measure 'TikTok Change Text' =
			VAR c = CALCULATE ( SUM ( scorecard[followers_change] ), KEEPFILTERS ( dim_platform[platform] = "TikTok" ) )
			VAR pct = CALCULATE ( SUM ( scorecard[followers_change_pct] ), KEEPFILTERS ( dim_platform[platform] = "TikTok" ) ) / 100
			VAR d = CALCULATE ( MAX ( scorecard[window_days] ), KEEPFILTERS ( dim_platform[platform] = "TikTok" ) )
			RETURN
			    IF ( c = 0,
			        "No visible change in " & d & " days",
			        IF ( c > 0, "▲ ", "▼ " ) & FORMAT ( ABS ( c ), "#,0" ) & " (" & FORMAT ( ABS ( pct ), "0.0%" ) & ") in " & d & " days" )
		displayFolder: 1 Overview
		lineageTag: c249b4b2-7de9-58f7-8b3d-c8b20a623739

	/// Views (likes on Instagram) all posts gained over the same days, and the number of new posts.
	measure 'TikTok Gained Text' =
			VAR g = CALCULATE ( SUM ( scorecard[metric_gained] ), KEEPFILTERS ( dim_platform[platform] = "TikTok" ) )
			VAR m = CALCULATE ( MAX ( scorecard[metric_name] ), KEEPFILTERS ( dim_platform[platform] = "TikTok" ) )
			VAR n = CALCULATE ( SUM ( scorecard[posts_in_window] ), KEEPFILTERS ( dim_platform[platform] = "TikTok" ) )
			RETURN "+" & IF ( ABS ( g ) >= 1000000, FORMAT ( g / 1000000, "0.0" ) & "M", IF ( ABS ( g ) >= 1000, FORMAT ( g / 1000, "0.0" ) & "K", FORMAT ( g, "#,0" ) ) ) & " " & m & " gained · " & n & " new posts"
		displayFolder: 1 Overview
		lineageTag: bbf94a2c-e90e-5648-8b5f-37ec10280b2f

	/// YouTube followers at the latest daily public count, 9 am PH. YouTube rounds subscribers to 3 digits.
	measure 'YouTube Followers Text' = FORMAT ( CALCULATE ( SUM ( scorecard[followers] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) ), "#,0" )
		displayFolder: 1 Overview
		lineageTag: 5228acd5-dc39-5ff7-b75b-390bd60082fd

	/// Follower change over about the last week. YouTube rounds subscribers, so small changes can show as none.
	measure 'YouTube Change Text' =
			VAR c = CALCULATE ( SUM ( scorecard[followers_change] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) )
			VAR pct = CALCULATE ( SUM ( scorecard[followers_change_pct] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) ) / 100
			VAR d = CALCULATE ( MAX ( scorecard[window_days] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) )
			RETURN
			    IF ( c = 0,
			        "No visible change in " & d & " days",
			        IF ( c > 0, "▲ ", "▼ " ) & FORMAT ( ABS ( c ), "#,0" ) & " (" & FORMAT ( ABS ( pct ), "0.0%" ) & ") in " & d & " days" )
		displayFolder: 1 Overview
		lineageTag: 08517809-75c5-50a3-a269-6a86d1e14c73

	/// Views (likes on Instagram) all posts gained over the same days, and the number of new posts.
	measure 'YouTube Gained Text' =
			VAR g = CALCULATE ( SUM ( scorecard[metric_gained] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) )
			VAR m = CALCULATE ( MAX ( scorecard[metric_name] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) )
			VAR n = CALCULATE ( SUM ( scorecard[posts_in_window] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) )
			RETURN "+" & IF ( ABS ( g ) >= 1000000, FORMAT ( g / 1000000, "0.0" ) & "M", IF ( ABS ( g ) >= 1000, FORMAT ( g / 1000, "0.0" ) & "K", FORMAT ( g, "#,0" ) ) ) & " " & m & " gained · " & n & " new posts"
		displayFolder: 1 Overview
		lineageTag: f7807a9e-f679-5c9c-a275-25a1d2936de8

	/// Instagram followers at the latest daily public count, 9 am PH.
	measure 'Instagram Followers Text' = FORMAT ( CALCULATE ( SUM ( scorecard[followers] ), KEEPFILTERS ( dim_platform[platform] = "Instagram" ) ), "#,0" )
		displayFolder: 1 Overview
		lineageTag: b3b01978-3ffc-54de-a653-187c1bcc7ff4

	/// Follower change over about the last week. YouTube rounds subscribers, so small changes can show as none.
	measure 'Instagram Change Text' =
			VAR c = CALCULATE ( SUM ( scorecard[followers_change] ), KEEPFILTERS ( dim_platform[platform] = "Instagram" ) )
			VAR pct = CALCULATE ( SUM ( scorecard[followers_change_pct] ), KEEPFILTERS ( dim_platform[platform] = "Instagram" ) ) / 100
			VAR d = CALCULATE ( MAX ( scorecard[window_days] ), KEEPFILTERS ( dim_platform[platform] = "Instagram" ) )
			RETURN
			    IF ( c = 0,
			        "No visible change in " & d & " days",
			        IF ( c > 0, "▲ ", "▼ " ) & FORMAT ( ABS ( c ), "#,0" ) & " (" & FORMAT ( ABS ( pct ), "0.0%" ) & ") in " & d & " days" )
		displayFolder: 1 Overview
		lineageTag: d91cad90-cb88-55e2-b585-510838f23e71

	/// Views (likes on Instagram) all posts gained over the same days, and the number of new posts.
	measure 'Instagram Gained Text' =
			VAR g = CALCULATE ( SUM ( scorecard[metric_gained] ), KEEPFILTERS ( dim_platform[platform] = "Instagram" ) )
			VAR m = CALCULATE ( MAX ( scorecard[metric_name] ), KEEPFILTERS ( dim_platform[platform] = "Instagram" ) )
			VAR n = CALCULATE ( SUM ( scorecard[posts_in_window] ), KEEPFILTERS ( dim_platform[platform] = "Instagram" ) )
			RETURN "+" & IF ( ABS ( g ) >= 1000000, FORMAT ( g / 1000000, "0.0" ) & "M", IF ( ABS ( g ) >= 1000, FORMAT ( g / 1000, "0.0" ) & "K", FORMAT ( g, "#,0" ) ) ) & " " & m & " gained · " & n & " new posts"
		displayFolder: 1 Overview
		lineageTag: b4458f9a-db97-5043-b287-6da90b626d68

	/// Followers each day ÷ followers on the first real day in the chosen dates, minus 1. A % so small and big channels fit one chart.
	measure 'Follower Growth %' =
			VAR cur = CALCULATE ( SUM ( account_daily[followers] ), KEEPFILTERS ( account_daily[data_source] = "real" ) )
			VAR firstDay = CALCULATE ( MIN ( account_daily[snapshot_date] ), ALLSELECTED ( account_daily[snapshot_date] ), account_daily[data_source] = "real" )
			VAR base = CALCULATE ( SUM ( account_daily[followers] ), account_daily[snapshot_date] = firstDay, account_daily[data_source] = "real" )
			RETURN IF ( NOT ISBLANK ( cur ), DIVIDE ( cur, base ) - 1 )
		formatString: 0.0%
		displayFolder: 1 Overview
		lineageTag: 868965ad-42b3-5cd7-8b02-a390cb1abbca

	/// TikTok + YouTube + Instagram followers at the latest daily count.
	measure 'Total Followers Text' = FORMAT ( SUM ( scorecard[followers] ), "#,0" ) & " followers on TikTok, YouTube and Instagram"
		displayFolder: 1 Overview
		lineageTag: e578547a-3c7e-5008-803d-f51666331793

	/// Day of the latest real daily count.
	measure 'As Of Text' = "Data as of " & FORMAT ( MAX ( scorecard[as_of] ), "d mmm yyyy" ) & " · counted daily at 9 am PH · hover a chart and point at its ? for what each number means"
		displayFolder: 1 Overview
		lineageTag: 377864e2-4ba4-541c-8829-43c26a9cfa61

	/// Written at 3 pm PH by a Claude routine from that day's numbers only.
	measure 'Insight Headline' = CALCULATE ( MAX ( insights[sentence] ), insights[slot] = "summary_headline" )
		displayFolder: 1 Overview
		lineageTag: 6c0b5679-a92f-59af-89b6-727d2d0662c2

	/// Written at 3 pm PH by a Claude routine from that day's numbers only.
	measure 'Insight Action 1' = CALCULATE ( MAX ( insights[sentence] ), insights[slot] = "action_1" )
		displayFolder: 1 Overview
		lineageTag: ab735b44-90a9-5bcc-9be5-fb8ef965c0e5

	/// Written at 3 pm PH by a Claude routine from that day's numbers only.
	measure 'Insight Action 2' = CALCULATE ( MAX ( insights[sentence] ), insights[slot] = "action_2" )
		displayFolder: 1 Overview
		lineageTag: c3ff94fb-3b04-5263-9717-d7a95a2e091f

	/// Written at 3 pm PH by a Claude routine from that day's numbers only.
	measure 'Insight Action 3' = CALCULATE ( MAX ( insights[sentence] ), insights[slot] = "action_3" )
		displayFolder: 1 Overview
		lineageTag: 4d13d9b6-b35c-59f7-b3a9-3a848861570e

	/// Written at 3 pm PH by a Claude routine from that day's numbers only.
	measure 'Insight Audience' = CALCULATE ( MAX ( insights[sentence] ), insights[slot] = "audience_headline" )
		displayFolder: 1 Overview
		lineageTag: 6ec47282-2c35-5c47-b9a1-9738578a5e4e

	/// Written at 3 pm PH by a Claude routine from that day's numbers only.
	measure 'Insight Sessions' = CALCULATE ( MAX ( insights[sentence] ), insights[slot] = "sessions_headline" )
		displayFolder: 1 Overview
		lineageTag: 943f7f53-581a-5fdc-b2ee-b9d130e1049b

	/// Written at 3 pm PH by a Claude routine from that day's numbers only.
	measure 'Insight Uploads' = CALCULATE ( MAX ( insights[sentence] ), insights[slot] = "upload_headline" )
		displayFolder: 1 Overview
		lineageTag: 4c9ca2e5-b391-5aa2-adf2-65ca03aeac9b

	/// When and how the sentences below were written.
	measure 'Insights Note' = "Written " & FORMAT ( MAX ( insights[as_of] ), "d mmm yyyy" ) & " at 3 pm PH by a Claude routine, from that day's numbers only"
		displayFolder: 1 Overview
		lineageTag: 1f48c9af-c587-551e-ae2f-1e4bc94719c4

	/// Views (likes on Instagram) the best post gained over about the last week.
	measure 'Best Post Gained' = SUM ( scorecard[best_post_gained] )
		formatString: #,0
		displayFolder: 1 Overview
		lineageTag: 1c261f0f-261a-5db2-bec1-2a0256d69e7a

	/// NDN TikToks left after the page filters.
	measure 'TikTok videos' = COUNTROWS ( tiktok_video )
		formatString: #,0
		displayFolder: 2 TikTok
		lineageTag: 56a74a96-860f-53d2-ad49-8550b301508d

	/// Middle views: half the videos got more, half fewer. From the daily public count, 9 am PH.
	measure 'Median views per TikTok' = MEDIAN ( tiktok_video[views] )
		formatString: #,0
		displayFolder: 2 TikTok
		lineageTag: e5957b99-7671-5985-bc4b-423d41b19051

	/// The middle video in the group: its views ÷ the usual views of the 30 NDN TikToks posted around it. 1.0 = usual, above 1 = better. Comparing with nearby posts keeps old and new videos fair.
	measure 'Median Index' = MEDIAN ( tiktok_video[perf_index] )
		formatString: 0.00
		displayFolder: 2 TikTok
		lineageTag: 2e58ae3c-b1ee-53f4-98eb-6a076161349d

	/// Share of NDN TikToks with at least twice the usual views of the 30 posts around them.
	measure 'Breakouts, all time' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( tiktok_video ), KEEPFILTERS ( tiktok_video[perf_index] >= 2 ) ),
			    CALCULATE ( COUNTROWS ( tiktok_video ), KEEPFILTERS ( NOT ISBLANK ( tiktok_video[perf_index] ) ) ) )
		formatString: 0%
		displayFolder: 2 TikTok
		lineageTag: 3958cecf-0dfd-5bb1-9d48-56724d969c93

	/// The same share, TikToks posted in the last 30 days.
	measure 'Breakouts, last 30 days' = CALCULATE ( [Breakouts, all time], KEEPFILTERS ( tiktok_video[is_last_30d] = "yes" ) )
		formatString: 0%
		displayFolder: 2 TikTok
		lineageTag: 32485aa8-45dd-5a4b-9e89-3482a84c7f09

	/// Views so far, TikToks posted in the last 30 days (daily public count, 9 am PH).
	measure 'TikTok Views 30d' = CALCULATE ( SUM ( tiktok_video[views] ), KEEPFILTERS ( tiktok_video[is_last_30d] = "yes" ) )
		formatString: #,0
		displayFolder: 2 TikTok
		lineageTag: 78a0ac01-ca5b-5397-815c-303d35b54ead

	/// Views ÷ the usual views of the 30 NDN TikToks posted around it. 2.0 or more = breakout.
	measure 'TikTok Index 30d' = CALCULATE ( MAX ( tiktok_video[perf_index] ), KEEPFILTERS ( tiktok_video[is_last_30d] = "yes" ) )
		formatString: 0.00
		displayFolder: 2 TikTok
		lineageTag: 65e0383f-d04a-50af-a835-93f3668194fe

	/// NDN YouTube videos left after the page filters.
	measure 'YouTube videos' = CALCULATE ( COUNTROWS ( dim_video ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) )
		formatString: #,0
		displayFolder: 3 YouTube
		lineageTag: a48bee7b-ff70-5d8d-9eb4-dfe8c58723ae

	/// Middle value of views so far ÷ days online: half the videos do better, half worse.
	measure 'YouTube Median Views/Day' = CALCULATE ( MEDIAN ( dim_video[views_per_day] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) )
		formatString: #,0
		displayFolder: 3 YouTube
		lineageTag: a3f72124-138b-5161-bc68-7d420769df88

	/// Full-length sessions only: middle value of views so far ÷ days online.
	measure 'Median views/day, full sessions' = CALCULATE ( MEDIAN ( dim_video[views_per_day] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ), KEEPFILTERS ( dim_video[video_format] = "Full video" ) )
		formatString: #,0
		displayFolder: 3 YouTube
		lineageTag: 7b1c1160-8746-526c-ae54-95c86662fd99

	/// YouTube Shorts only: middle value of views so far ÷ days online.
	measure 'Median views/day, Shorts' = CALCULATE ( MEDIAN ( dim_video[views_per_day] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ), KEEPFILTERS ( dim_video[video_format] = "Short (<=60 s)" ) )
		formatString: #,0
		displayFolder: 3 YouTube
		lineageTag: 696f0c1a-f1d3-5c87-918a-aad654a819e0

	/// All NDN YouTube videos added up over about the last week of daily counts.
	measure 'YouTube views gained, last 7 days' = CALCULATE ( SUM ( scorecard[metric_gained] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) )
		formatString: #,0
		displayFolder: 3 YouTube
		lineageTag: 4c90eb6e-becc-522e-bc17-979e9770b406

	/// All NDN YouTube videos added up, real daily counts only.
	measure 'YouTube Views Gained Real' = CALCULATE ( SUM ( platform_daily[views_gained] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ), KEEPFILTERS ( platform_daily[data_source] = "real" ) )
		formatString: #,0
		displayFolder: 3 YouTube
		lineageTag: 07986726-ef82-580e-8c88-99f060e4503f

	/// Views so far ÷ days online, videos uploaded in the last 90 days.
	measure 'YouTube Views/Day 90d' = CALCULATE ( SUM ( dim_video[views_per_day] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ), KEEPFILTERS ( dim_video[age_days] <= 90 ) )
		formatString: #,0
		displayFolder: 3 YouTube
		lineageTag: b521e881-40ce-59d3-84a1-67244e2e6877

	/// Views per day ÷ the middle video of the same series. 2.0 = twice as good as usual for the series.
	measure 'YouTube vs Series 90d' = CALCULATE ( MAX ( dim_video[vs_series_median] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ), KEEPFILTERS ( dim_video[age_days] <= 90 ) )
		formatString: 0.0
		displayFolder: 3 YouTube
		lineageTag: 2a03ac35-b77b-5efc-ba6c-7df58838f7d1

	/// Views per day added up over the artist's NDN YouTube videos.
	measure 'YouTube Artist Views/Day' = CALCULATE ( SUM ( dim_video[views_per_day] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) )
		formatString: #,0
		displayFolder: 3 YouTube
		lineageTag: f837817c-d8a7-5a9e-904d-17d24484e72f

	/// Top 10 artists: views per day added up over their NDN YouTube videos.
	measure 'YouTube Artist Views/Day Top 10' =
			VAR r = RANKX ( FILTER ( ALLSELECTED ( dim_video[artist] ), NOT ISBLANK ( dim_video[artist] ) ), [YouTube Artist Views/Day] )
			RETURN IF ( NOT ISBLANK ( SELECTEDVALUE ( dim_video[artist] ) ) && r <= 10, [YouTube Artist Views/Day] )
		formatString: #,0
		displayFolder: 3 YouTube
		lineageTag: 06ca905a-40ff-52b5-9579-2cd69dbef3b8

	/// NDN Instagram posts left after the page filters.
	measure 'Instagram posts' = CALCULATE ( COUNTROWS ( dim_video ), KEEPFILTERS ( dim_platform[platform] = "Instagram" ) )
		formatString: #,0
		displayFolder: 4 Instagram
		lineageTag: d8e5aa69-8b9a-5e74-9509-21250f086bf7

	/// Middle value of likes so far ÷ days online: half the posts do better, half worse.
	measure 'Median likes/day, all posts' = CALCULATE ( MEDIAN ( dim_video[likes_per_day] ), KEEPFILTERS ( dim_platform[platform] = "Instagram" ) )
		formatString: #,0
		displayFolder: 4 Instagram
		lineageTag: 0c7e624e-1619-5195-8fad-171c499eeabd

	/// Reels only: middle value of views so far ÷ days online. Instagram's view count includes Facebook views since April 2026.
	measure 'Median views/day, Reels' = CALCULATE ( MEDIAN ( dim_video[views_per_day] ), KEEPFILTERS ( dim_platform[platform] = "Instagram" ), KEEPFILTERS ( dim_video[video_format] = "Instagram Reel" ) )
		formatString: #,0
		displayFolder: 4 Instagram
		lineageTag: 05c7c71a-af3e-528a-a8de-3f635af66da4

	/// All NDN Instagram posts added up. Real daily counts started 15 Oct 2026.
	measure 'Instagram likes gained, last 6 days' = CALCULATE ( SUM ( scorecard[metric_gained] ), KEEPFILTERS ( dim_platform[platform] = "Instagram" ) )
		formatString: #,0
		displayFolder: 4 Instagram
		lineageTag: fbdcf2bd-6f5b-59d9-a205-cfb0107a9827

	/// All NDN Instagram posts added up, real daily counts only.
	measure 'Instagram Likes Gained Real' = CALCULATE ( SUM ( platform_daily[likes_gained] ), KEEPFILTERS ( dim_platform[platform] = "Instagram" ), KEEPFILTERS ( platform_daily[data_source] = "real" ) )
		formatString: #,0
		displayFolder: 4 Instagram
		lineageTag: ccf63bc2-de89-522f-9f15-f1f8cf45cd15

	/// Likes so far ÷ days online, posts of the last 90 days.
	measure 'Instagram Likes/Day 90d' = CALCULATE ( SUM ( dim_video[likes_per_day] ), KEEPFILTERS ( dim_platform[platform] = "Instagram" ), KEEPFILTERS ( dim_video[age_days] <= 90 ) )
		formatString: #,0
		displayFolder: 4 Instagram
		lineageTag: 2c188233-0ba7-5588-aee4-e113539c4c68

	/// Reels of the last 90 days: views so far ÷ days online.
	measure 'Instagram Views/Day 90d' = CALCULATE ( SUM ( dim_video[views_per_day] ), KEEPFILTERS ( dim_platform[platform] = "Instagram" ), KEEPFILTERS ( dim_video[age_days] <= 90 ) )
		formatString: #,0
		displayFolder: 4 Instagram
		lineageTag: b896648b-a2f4-5a06-aad3-2d030c1a6fd7

	/// Share of the month's TikToks with at least twice the usual views of the posts around them.
	measure 'Breakout share' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( tiktok_video ), KEEPFILTERS ( tiktok_video[perf_index] >= 2 ) ),
			    CALCULATE ( COUNTROWS ( tiktok_video ), KEEPFILTERS ( NOT ISBLANK ( tiktok_video[perf_index] ) ) ) )
		formatString: 0%
		displayFolder: 2 TikTok
		lineageTag: 8d0c4195-a00c-56dd-9667-c91f962b1c51

	/// The middle video: (shares + saves) ÷ views × 1,000. TikTok reads both as strong signs people value a video.
	measure 'Median shares+saves per 1k' = MEDIAN ( tiktok_video[share_save_per_1k] )
		formatString: 0.0
		displayFolder: 2 TikTok
		lineageTag: 281f718d-fff6-58d1-a0ea-be367d89dfd7

	/// The middle video: comments ÷ views × 1,000.
	measure 'Median comments per 1k' = MEDIAN ( tiktok_video[comments_per_1k] )
		formatString: 0.0
		displayFolder: 2 TikTok
		lineageTag: a1cdb797-24a7-5c64-a6d1-797b2be49e7f

	/// The middle video: views added over the last 7 daily counts.
	measure 'Median 7-day views gained' = MEDIAN ( tiktok_video[views_gained_7d] )
		formatString: #,0
		displayFolder: 2 TikTok
		lineageTag: b9326dfd-f879-5a25-b82a-06c1ed79a36a

	/// Videos older than 30 days, the middle one: views gained in the last 7 days ÷ views so far × 1,000. Higher = still being found.
	measure 'Median 7-day gain per 1k, older posts' = CALCULATE ( MEDIAN ( tiktok_video[gained_7d_per_1k] ), KEEPFILTERS ( tiktok_video[age_days] > 30 ) )
		formatString: 0.00
		displayFolder: 2 TikTok
		lineageTag: 794edbaa-6457-5af8-a9fa-537bf25a0c68

	/// Videos by anyone on TikTok that use the sound of an NDN post (sound pages, latest weekly count).
	measure 'Videos made with NDN sounds' = SUM ( tiktok_video[sound_uses] )
		formatString: #,0
		displayFolder: 2 TikTok
		lineageTag: d83e3f42-5dc9-54fb-98eb-49b613d32199

	/// (Shares + saves) ÷ views × 1,000 for this TikTok.
	measure 'Shares+saves per 1k' = MAX ( tiktok_video[share_save_per_1k] )
		formatString: 0.0
		displayFolder: 2 TikTok
		lineageTag: 42bee670-a7b7-51c4-8ef0-fe9cef97c4f2

	/// Videos by anyone on TikTok made with this post's NDN sound (latest weekly count).
	measure 'Sound uses' = SUM ( tiktok_video[sound_uses] )
		formatString: #,0
		displayFolder: 2 TikTok
		lineageTag: ea4c81c8-8218-51cb-8f54-10919de4b7e8

	/// Top 10 artists with 3 or more NDN TikToks: their middle clip's views ÷ the usual. 1.0 = usual.
	measure 'TikTok Artist Index Top 10' =
			VAR r = RANKX ( FILTER ( ALLSELECTED ( tiktok_video[artist] ),
			            NOT ISBLANK ( tiktok_video[artist] ) && CALCULATE ( COUNTROWS ( tiktok_video ) ) >= 3 ), [Median Index] )
			RETURN IF ( NOT ISBLANK ( SELECTEDVALUE ( tiktok_video[artist] ) ) && COUNTROWS ( tiktok_video ) >= 3 && r <= 10, [Median Index] )
		formatString: 0.00
		displayFolder: 2 TikTok
		lineageTag: bc959bf6-66d7-57f5-9011-d97f6fe28cf8

	/// The middle video: (likes + comments) ÷ views. 3% = 3 likes or comments per 100 views.
	measure 'YouTube engagement rate' = CALCULATE ( MEDIAN ( dim_video[engagement_rate] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) )
		formatString: 0.00%
		displayFolder: 3 YouTube
		lineageTag: 2f6f5c82-5df0-52c7-9e19-032480c4611c

	/// The middle video: views added over the last 7 daily counts.
	measure 'YouTube median 7-day gain' = CALCULATE ( MEDIAN ( dim_video[views_gained_7d] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) )
		formatString: #,0
		displayFolder: 3 YouTube
		lineageTag: 2e86140d-1134-5629-9624-450e59532bd6

	/// Sessions over a year old: views added over the last 7 daily counts.
	measure 'YouTube 7-day gain, older sessions' = CALCULATE ( SUM ( dim_video[views_gained_7d] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ), KEEPFILTERS ( dim_video[age_days] >= 365 ) )
		formatString: #,0
		displayFolder: 3 YouTube
		lineageTag: d952893f-6f38-5d8a-80be-3259de3586ca

	/// Full sessions: views so far ÷ days online.
	measure 'YouTube views per day' = CALCULATE ( SUM ( dim_video[views_per_day] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ), KEEPFILTERS ( dim_video[video_format] = "Full video" ) )
		formatString: #,0
