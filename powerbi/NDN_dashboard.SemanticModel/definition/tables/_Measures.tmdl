	/// How the artist's past NDN TikToks and YouTube sessions did compared with NDN's usual, as a 0-100 score against all artists checked. New artists get 50. Weight 5%.
	measure 'Inv track_record' = IF ( [Inv Rank Raw] <= 10, CALCULATE ( SUM ( invite[track_record] ), KEEPFILTERS ( invite[status] = "Recommend" ) ) )
		formatString: 0
