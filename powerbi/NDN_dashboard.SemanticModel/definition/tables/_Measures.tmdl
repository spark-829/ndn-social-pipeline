		lineageTag: 7b373b8a-f5ec-5b36-9a63-aea4dc1ccfa4

	/// Different people asking for the artist, last 12 months. One person asking 5 times counts once.
	measure 'Fans Asking' = SUM ( fan_demand[fans] )
		formatString: #,0
		displayFolder: 7 Community
		lineageTag: 2ca9818f-3d01-5446-9a13-974e320c73de

	/// Top 15 artists by different people asking, last 12 months.
	measure 'Fans Asking Top 15' =
			VAR r = RANKX ( ALLSELECTED ( fan_demand[artist] ), [Fans Asking] )
			RETURN IF ( r <= 15, [Fans Asking] )
		formatString: #,0
		displayFolder: 7 Community
		lineageTag: 043b5d02-961c-59cb-9090-be4a6c60a4d2

	/// Works behind the scenes (ranking or colour); not shown as a number.
	measure 'Is Never Played' = IF ( SELECTEDVALUE ( fan_demand[status] ) = "Never on NDN", 1, 0 )
		formatString: 0
		displayFolder: 7 Community
		lineageTag: fee0a3ec-995a-59f2-852f-0ee69b50185c

	/// Works behind the scenes (ranking or colour); not shown as a number.
	measure 'Inv Score Raw' = CALCULATE ( SUM ( invite[score] ), KEEPFILTERS ( invite[status] = "Recommend" ) )
		formatString: 0.0
		displayFolder: 2 Invite
		lineageTag: e1c30327-246f-5fa8-8b78-311d324a7628

	/// Works behind the scenes (ranking or colour); not shown as a number.
	measure 'Inv Rank Raw' =
			IF ( NOT ISBLANK ( [Inv Score Raw] ),
			    RANKX ( FILTER ( ALLSELECTED ( invite[artist] ), NOT ISBLANK ( [Inv Score Raw] ) ), [Inv Score Raw] ) )
		formatString: 0
		displayFolder: 2 Invite
		lineageTag: 3dfe5316-f508-5a45-a244-515a1c81fcca

	/// Place by invite score among the artists the page filters leave (1 = best).
	measure 'Inv Rank' = IF ( [Inv Rank Raw] <= 10, [Inv Rank Raw] )
		formatString: 0
		displayFolder: 2 Invite
		lineageTag: ce00720e-7cd9-556b-84ee-b2270d637496

	/// The nine parts added up with their weights: TikTok 55, Spotify 30, other 15. Each part scores 0-100 against all artists checked (100 = top, 50 = middle, no data = 0). Higher = better to invite now.
	measure 'Inv score' = IF ( [Inv Rank Raw] <= 10, CALCULATE ( SUM ( invite[score] ), KEEPFILTERS ( invite[status] = "Recommend" ) ) )
		formatString: 0.0
		displayFolder: 2 Invite
		lineageTag: 4865c1f5-c92c-51ea-a131-47a4be535258

	/// The four TikTok parts after weighting.
	measure 'Inv tiktok_points' = IF ( [Inv Rank Raw] <= 10, CALCULATE ( SUM ( invite[tiktok_points] ), KEEPFILTERS ( invite[status] = "Recommend" ) ) )
		formatString: 0.0
		displayFolder: 2 Invite
		lineageTag: 63522144-923c-5219-810f-4225e22050ab

	/// The three Spotify parts after weighting.
	measure 'Inv spotify_points' = IF ( [Inv Rank Raw] <= 10, CALCULATE ( SUM ( invite[spotify_points] ), KEEPFILTERS ( invite[status] = "Recommend" ) ) )
		formatString: 0.0
		displayFolder: 2 Invite
		lineageTag: 2417cfba-ef18-592e-854b-2cfb69f4f99d

	/// Fan requests and artist size after weighting.
	measure 'Inv other_points' = IF ( [Inv Rank Raw] <= 10, CALCULATE ( SUM ( invite[other_points] ), KEEPFILTERS ( invite[status] = "Recommend" ) ) )
		formatString: 0.0
		displayFolder: 2 Invite
		lineageTag: b12c5d06-f74a-5ab6-a0c3-3a322bed1af1

	/// All TikTok videos using the new song (its official sound plus versions found by searching its title on TikTok every 3 days), as a 0-100 score against all artists checked. Weight 25%.
	measure 'Inv tt_song_videos' = IF ( [Inv Rank Raw] <= 10, CALCULATE ( SUM ( invite[tt_song_videos] ), KEEPFILTERS ( invite[status] = "Recommend" ) ) )
		formatString: 0
		displayFolder: 2 Invite
		lineageTag: 89341512-b48a-55f4-9c00-8b99fb45967e

	/// How fast those videos grew over 4 weeks, as a 0-100 score against all artists checked. Weight 15%. 0 for everyone until the second weekly count (Mon 26 Oct 2026).
	measure 'Inv tt_song_growth' = IF ( [Inv Rank Raw] <= 10, CALCULATE ( SUM ( invite[tt_song_growth] ), KEEPFILTERS ( invite[status] = "Recommend" ) ) )
		formatString: 0
		displayFolder: 2 Invite
		lineageTag: 0d2584a0-5fc2-5936-a6f8-40aa1072cddd

	/// Follower growth of the artist's TikTok over 4 weeks (public profile, weekly), as a 0-100 score against all artists checked. Weight 10%.
