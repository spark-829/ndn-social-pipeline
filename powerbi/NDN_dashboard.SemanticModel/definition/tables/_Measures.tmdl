	/// People who played the artist on Spotify in the last 28 days (Spotify artist page, weekly).
	measure 'YouTube artist listeners' = CALCULATE ( MAX ( dim_video[artist_monthly_listeners] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ), KEEPFILTERS ( dim_video[video_format] = "Full video" ) )
		formatString: #,0
		displayFolder: 3 YouTube
		lineageTag: 0541a73c-d938-5260-9d7c-db98f97a98de

	/// All-time Spotify plays of the studio version of the song (kworb.net, weekly).
