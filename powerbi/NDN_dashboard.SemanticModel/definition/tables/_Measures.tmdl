		lineageTag: edd0c5b3-b828-5936-8924-f16c66036502

	/// Works behind the scenes (ranking or colour); not shown as a number.
	measure 'Is NDN Uploads' = IF ( SELECTEDVALUE ( bench_uploads[region] ) = "ndn", 1, 0 )
		formatString: 0
		displayFolder: 5 Benchmarks
		lineageTag: 64706dec-7a89-5400-9e9f-4f76b75cf9c0

	/// Artists named in NDN's YouTube + TikTok comments asking NDN to feature them, last 12 months.
	measure 'Artists fans ask for' = COUNTROWS ( fan_demand )
		formatString: #,0
		displayFolder: 7 Community
		lineageTag: dac52ffc-e5c1-5f26-b03f-f53f59c2b60d

	/// Of those, artists NDN hasn't filmed yet.
	measure 'Never on NDN' = CALCULATE ( COUNTROWS ( fan_demand ), KEEPFILTERS ( fan_demand[status] = "Never on NDN" ) )
		formatString: #,0
		displayFolder: 7 Community
		lineageTag: b646fbfe-b6db-5e3c-a83c-a47242bdb84b

	/// Artists whose filmed session fans ask NDN to post or put on streaming.
