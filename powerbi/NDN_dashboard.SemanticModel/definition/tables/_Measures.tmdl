/// Holds every DAX measure; the placeholder column is hidden.
table _Measures
	lineageTag: a7610168-a129-5d42-9da4-679b27f1bd07

	measure 'TikTok Followers Text' = FORMAT ( CALCULATE ( SUM ( scorecard[followers] ), KEEPFILTERS ( dim_platform[platform] = "TikTok" ) ), "#,0" )
		displayFolder: 1 Overview
		lineageTag: 5758e63b-aaf5-57fb-988b-e2c04f90e682

	/// Follower change over the scorecard window. YouTube rounds subscribers to 3 digits, so small changes show as none.
	measure 'TikTok Change Text' =
			VAR c = CALCULATE ( SUM ( scorecard[followers_change] ), KEEPFILTERS ( dim_platform[platform] = "TikTok" ) )
			VAR pct = CALCULATE ( SUM ( scorecard[followers_change_pct] ), KEEPFILTERS ( dim_platform[platform] = "TikTok" ) ) / 100
			VAR d = CALCULATE ( MAX ( scorecard[window_days] ), KEEPFILTERS ( dim_platform[platform] = "TikTok" ) )
			RETURN
			    IF ( c = 0,
			        "No visible change in " & d & " days",
			        IF ( c > 0, "▲ ", "▼ " ) & FORMAT ( ABS ( c ), "#,0" ) & " (" & FORMAT ( ABS ( pct ), "0.0%" ) & ") in " & d & " days" )
		displayFolder: 1 Overview
		lineageTag: c249b4b2-7de9-58f7-8b3d-c8b20a623739

	measure 'TikTok Gained Text' =
			VAR g = CALCULATE ( SUM ( scorecard[metric_gained] ), KEEPFILTERS ( dim_platform[platform] = "TikTok" ) )
			VAR m = CALCULATE ( MAX ( scorecard[metric_name] ), KEEPFILTERS ( dim_platform[platform] = "TikTok" ) )
			VAR n = CALCULATE ( SUM ( scorecard[posts_in_window] ), KEEPFILTERS ( dim_platform[platform] = "TikTok" ) )
			RETURN "+" & IF ( ABS ( g ) >= 1000000, FORMAT ( g / 1000000, "0.0" ) & "M", IF ( ABS ( g ) >= 1000, FORMAT ( g / 1000, "0.0" ) & "K", FORMAT ( g, "#,0" ) ) ) & " " & m & " gained · " & n & " new posts"
		displayFolder: 1 Overview
		lineageTag: bbf94a2c-e90e-5648-8b5f-37ec10280b2f

	measure 'YouTube Followers Text' = FORMAT ( CALCULATE ( SUM ( scorecard[followers] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) ), "#,0" )
		displayFolder: 1 Overview
		lineageTag: 5228acd5-dc39-5ff7-b75b-390bd60082fd

	/// Follower change over the scorecard window. YouTube rounds subscribers to 3 digits, so small changes show as none.
	measure 'YouTube Change Text' =
			VAR c = CALCULATE ( SUM ( scorecard[followers_change] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) )
			VAR pct = CALCULATE ( SUM ( scorecard[followers_change_pct] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) ) / 100
			VAR d = CALCULATE ( MAX ( scorecard[window_days] ), KEEPFILTERS ( dim_platform[platform] = "YouTube" ) )
			RETURN
			    IF ( c = 0,
			        "No visible change in " & d & " days",
			        IF ( c > 0, "▲ ", "▼ " ) & FORMAT ( ABS ( c ), "#,0" ) & " (" & FORMAT ( ABS ( pct ), "0.0%" ) & ") in " & d & " days" )
