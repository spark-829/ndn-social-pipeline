		lineageTag: 4b13a057-eb71-50b9-8224-c9b628f714b0

	/// Where the new song's buzz shows: TikTok, Spotify or both.
	measure 'Pob new_hit_found_on' = IF ( [Pob Rank Raw] <= 10, CALCULATE ( SELECTEDVALUE ( invite[new_hit_found_on] ), KEEPFILTERS ( invite[status] = "Post or boost" ) ) )
		displayFolder: 2 Invite
		lineageTag: 59948e31-f19c-50e0-a22e-cf5ab9f17f42

	/// The artist's most-played song on Spotify right now.
	measure 'Pob top_song' = IF ( [Pob Rank Raw] <= 10, CALCULATE ( SELECTEDVALUE ( invite[top_song] ), KEEPFILTERS ( invite[status] = "Post or boost" ) ) )
		displayFolder: 2 Invite
		lineageTag: 1b3beb6f-b2e1-5c6e-895f-304ae8b1c072

	/// yes = NDN already has that song on YouTube.
	measure 'Pob top_song_on_ndn' = IF ( [Pob Rank Raw] <= 10, CALCULATE ( SELECTEDVALUE ( invite[top_song_on_ndn] ), KEEPFILTERS ( invite[status] = "Post or boost" ) ) )
		displayFolder: 2 Invite
		lineageTag: f9276fe9-0819-54c3-acb4-4f0a58f033da

	/// The artist's song with the most TikTok videos using its sound.
	measure 'Pob top_tiktok_song' = IF ( [Pob Rank Raw] <= 10, CALCULATE ( SELECTEDVALUE ( invite[top_tiktok_song] ), KEEPFILTERS ( invite[status] = "Post or boost" ) ) )
		displayFolder: 2 Invite
		lineageTag: b8c20d7f-44bf-5af4-989e-506fe8b07f19

	/// New hit not on NDN / Hit already on NDN / Played for NDN, song not filmed.
	measure 'Pob hit_status' = IF ( [Pob Rank Raw] <= 10, CALCULATE ( SELECTEDVALUE ( invite[hit_status] ), KEEPFILTERS ( invite[status] = "Post or boost" ) ) )
		displayFolder: 2 Invite
		lineageTag: 3cc2e1ed-3281-5eaf-8c7a-f9c6dae67b37

	/// The artist's TikTok account: listed by Vic, tagged in NDN captions, or matched from their Instagram name and checked.
	measure 'Pob tiktok_handle' = IF ( [Pob Rank Raw] <= 10, CALCULATE ( SELECTEDVALUE ( invite[tiktok_handle] ), KEEPFILTERS ( invite[status] = "Post or boost" ) ) )
		displayFolder: 2 Invite
		lineageTag: 97d01ca9-2b4f-5df7-ac9e-16bbebdb0761

	/// Invite / boost the NDN video of this song / post the band's clips or film this song.
	measure 'Pob action' = IF ( [Pob Rank Raw] <= 10, CALCULATE ( SELECTEDVALUE ( invite[action] ), KEEPFILTERS ( invite[status] = "Post or boost" ) ) )
		displayFolder: 2 Invite
		lineageTag: fc783ab6-6b79-5b38-92f0-cf6708fb9762

	/// NDN's YouTube video of this song; if none, the band's most viewed NDN video.
	measure 'Pob ndn_video_title' = IF ( [Pob Rank Raw] <= 10, CALCULATE ( SELECTEDVALUE ( invite[ndn_video_title] ), KEEPFILTERS ( invite[status] = "Post or boost" ) ) )
		displayFolder: 2 Invite
		lineageTag: f22027da-68e5-55b2-aeb4-263da327581c

	/// Artists the invite score was worked out for: NDN artists, Vic's list and OPM artists from Spotify's PH chart and Viral Hits PH.
	measure 'Artists scored' = COUNTROWS ( invite )
		formatString: #,0
		displayFolder: 2 Invite
		lineageTag: 59d27c05-2de2-5e70-9559-a9df1a823d56

	/// Artists of the OPM top 30 who never played for NDN: invite them.
	measure 'To invite' = CALCULATE ( COUNTROWS ( invite ), KEEPFILTERS ( invite[status] = "Recommend" ) )
		formatString: #,0
		displayFolder: 2 Invite
		lineageTag: 786af947-636b-5422-8062-7e211b8fedbe

	/// Artists of the OPM top 30 NDN already has: their hot song is on NDN's YouTube (boost it), or they played for NDN before (post their clips).
	measure 'To post or boost' = CALCULATE ( COUNTROWS ( invite ), KEEPFILTERS ( invite[status] = "Post or boost" ) )
		formatString: #,0
		displayFolder: 2 Invite
		lineageTag: 0cb6a686-b547-5a27-95ba-191e394df70d

	/// Songs in the OPM top 30 that are already on NDN's YouTube.
	measure 'Hot songs NDN has' = CALCULATE ( COUNTROWS ( invite_top30 ), KEEPFILTERS ( invite_top30[on_ndn] = "yes" ) )
		formatString: #,0
		displayFolder: 2 Invite
		lineageTag: 2f713483-1262-557f-9595-e3713b3a83ec

	column placeholder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8f490794-1439-5cdc-a840-aee0487c1f63
