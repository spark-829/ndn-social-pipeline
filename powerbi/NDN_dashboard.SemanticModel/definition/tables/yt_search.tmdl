/// yt_search
table yt_search
	lineageTag: 5cd0354b-611a-5205-87f2-b703fe13ffe4

	column query
		dataType: string
		lineageTag: 7e575f82-5e0c-57af-be4c-1b91c118b729
		sourceColumn: query

