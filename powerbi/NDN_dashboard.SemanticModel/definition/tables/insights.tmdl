/// Today's dashboard sentences, written at 15:00 PH by the Claude routine from that day's numbers.
table insights
	lineageTag: 924c959f-cc47-50d8-9e2d-448eb796728e

	column as_of
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: d237cc01-1415-5bfe-8552-40b69ed5cf0d
		summarizeBy: none
		sourceColumn: as_of

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = User

	column slot
		dataType: string
		lineageTag: ead82219-759c-5207-ad07-59c0688110c5
		sourceColumn: slot

		annotation SummarizationSetBy = User

	column sort_order
		dataType: int64
		formatString: #,0
		lineageTag: 5bb333dd-f149-5e2b-a4f0-d981f1d36b38
		summarizeBy: none
		sourceColumn: sort_order

		annotation SummarizationSetBy = User

	column sentence
		dataType: string
		lineageTag: 6e566e69-393a-5402-9f7e-928f462a4586
		sourceColumn: sentence

		annotation SummarizationSetBy = User

	partition insights = m
		mode: import
		source =
				let
				    Source = fnLoadCsv("insights.csv"),
				    Nulls = Table.ReplaceValue(Source, "", null, Replacer.ReplaceValue, Table.ColumnNames(Source)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"as_of", type date}, {"slot", type text}, {"sort_order", Int64.Type}, {"sentence", type text}}, "en-US")
				in
				    Typed
