# secrets
.env
# raw data stays local (it is regenerated by the extractors)
data/
__pycache__/
logs/
# Tableau exports are regenerated by export_tableau.py
tableau/
# Tableau Desktop/Public log
hyperd.log
# Power BI Desktop's local cache and settings (powerbi/data/ is covered by data/ above)
**/.pbi/localSettings.json
**/.pbi/cache.abf
# one-off edit scripts
sql/_e.py
# downloaded Microsoft schemas used by powerbi/tools/validate_pbir.py
powerbi/tools/schema_cache/
# Supabase CLI local cache
supabase/.temp/

# local backups (data snapshots, server scripts): not for the public repo
backup/
